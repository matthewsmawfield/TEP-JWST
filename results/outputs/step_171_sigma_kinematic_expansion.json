  "methodology": {
    "description": "Sigma-based mass-circularity-breaking test suite. R_ML is computed from velocity dispersion alone, with zero dependence on SED-fitted M* or size-based Mdyn. Two sigma->depth constructions are carried in parallel: (a) a literature-calibrated virial sigma->M_halo map whose -1.5*log10(1+z) drift encodes expanding-cosmology halo evolution, and (b) a cosmology-free direct sigma->Psi map (Psi ~ sigma^2, anchored to map (a) at z=0, sigma=200 km/s). The primary test (T1) compares the observed M*-sigma residual-z trend with the TEP-predicted direction, which is itself construction-dependent (T6). The secondary test (T3) asks whether the sigma-only R_ML adds predictive power for M*_obs beyond sigma and z individually; since R_ML is a deterministic function of (sigma, z) this partial is intrinsically low-power. Tracer stratification: absorption-line sigma (stellar dynamics, quiescent galaxies) is the primary clean tracer; emission-line sigma (gas kinematics, star-forming galaxies) is contaminated by outflows, turbulence, and beam smearing and is treated as a secondary gas-kinematics test. Residuals in T1/T2/T4/T5 are stored as (fit - y), the negative of the conventional residual; T6 reports conventional signs explicitly.",
    "gamma_t_derivation": "virial map: log(M_h) = 5.0 * log10(sigma / 200.0 km/s) + 12.5 - 1.5*log10(1+z); direct map: Psi = Psi_ref * (sigma/136.3 km/s)^2; R_ML = compute_ml_response(log_Mh, z) / compute_ml_response_from_depth(Psi, z), clipped to the canonical [0.01, 100] domain",
    "mass_correction_model": "n_ML = 0.5",
    "kappa_gal": 960000.0,
    "combined_sample_sources": [
      "SUSPENSE (Slob+25)",
      "Esdaile+21 / Tanaka+19",
      "de Graaff et al. 2024",
      "Saldana-Lopez et al. 2025",
      "Danhaive et al. 2025"
    ],
    "mass_proxy_independence": "R_ML_sigma_only is derived entirely from the velocity dispersion sigma (km/s) via a sigma\u2013M_halo mapping. It has zero dependence on SED-fitted M*, half-light radius R_e, or dynamical mass M_dyn. This reduces the mass-proxy circularity but does not remove sensitivity to the adopted sigma\u2013M_halo mapping or sample composition.",
    "tracer_stratification": {
      "absorption_sources": [
        "Slob et al. 2025",
        "Esdaile et al. 2021",
        "Tanaka et al. 2019"
      ],
      "absorption_description": "Stellar absorption-line sigma (quiescent galaxies, clean dynamical tracer)",
      "emission_description": "Gas emission-line sigma (star-forming galaxies, contaminated by outflows/turbulence)",
      "primary_tracer": "absorption",
      "secondary_tracer": "emission"
    }
  }
